# ─────────────────────────────────────────────
# JobForge Backend — Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# App
APP_NAME=JobForge
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-string

# ─── LLM Provider ────────────────────────────
# Ollama (local, no API key needed) ← default
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_SMART=qwen2.5:7b        # Coordinator, DocGen, Rank agents
LLM_MODEL_FAST=llama3.2:3b        # Search agent (parallel calls)

# ─── Switch to OpenAI anytime (zero code change) ───
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL_SMART=gpt-4o
# LLM_MODEL_FAST=gpt-4o-mini

# ─── Switch to Groq (free tier) ────────────────
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL_SMART=llama-3.3-70b-versatile
# LLM_MODEL_FAST=llama-3.1-8b-instant

# ─── Database ────────────────────────────────
# SQLite — zero setup, perfect for development
DATABASE_URL=sqlite+aiosqlite:///./jobforge.db

# PostgreSQL — uncomment for production
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/jobforge

# ─── Redis (optional — only needed for Celery background tasks) ───
REDIS_URL=redis://localhost:6379/0

# ─── Documents ───────────────────────────────
DOCUMENTS_DIR=./documents          # where PDFs are saved

# ─── CORS (add your frontend URL) ────────────
CORS_ORIGINS=["http://localhost:3000"]
