# ─────────────────────────────────────────────────────────────────────────────
# JobForge Backend — Environment Variables
# Copy this to .env  →  cp .env.example .env
# When running via Docker Compose, DATABASE_URL and REDIS_URL are
# overridden automatically by docker-compose.yml — no need to change them here.
# ─────────────────────────────────────────────────────────────────────────────

# App
APP_NAME=JobForge
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-string-in-production

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Ollama on HOST (default — free, local, no API key)
# Docker reaches host Ollama via host.docker.internal (set in docker-compose.yml)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_SMART=qwen2.5:7b        # Coordinator, DocGen, Rank agents
LLM_MODEL_FAST=llama3.2:3b        # Search agent (parallel, speed matters)

# ── Switch to OpenAI (one line change, zero code change) ─────────────────────
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL_SMART=gpt-4o
# LLM_MODEL_FAST=gpt-4o-mini

# ── Switch to Groq free tier ──────────────────────────────────────────────────
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL_SMART=llama-3.3-70b-versatile
# LLM_MODEL_FAST=llama-3.1-8b-instant

# ── Database ──────────────────────────────────────────────────────────────────
# Docker Compose overrides this to point at the postgres container.
# Keep SQLite here for running backend outside Docker if needed.
DATABASE_URL=sqlite+aiosqlite:///./jobforge.db

# ── Redis ─────────────────────────────────────────────────────────────────────
# Docker Compose overrides this to point at the redis container.
REDIS_URL=redis://localhost:6379/0

# ── Documents ─────────────────────────────────────────────────────────────────
DOCUMENTS_DIR=./documents

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
